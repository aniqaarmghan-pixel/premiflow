# Server-only. Do not prefix any of these with NEXT_PUBLIC_.
# The browser talks to /api/rpc and /api/auth; these values never ship to client JavaScript.

# Existing Devnet RPC used by /api/rpc and server-side contract party reads.
SOLANA_RPC_URL=

# Neon Postgres connection string for Contract Messages.
DATABASE_URL=

# 32+ character secret used to HMAC session tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Allowed browser origin for cookie-authenticated POST routes. Example: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Optional. Challenge lifetime in seconds. Default 300.
# AUTH_CHALLENGE_TTL_SECONDS=300

# Optional. Session lifetime in seconds. Default 604800 (7 days).
# SESSION_TTL_SECONDS=604800
