# Server-only. Do not prefix any of these with NEXT_PUBLIC_.
# The browser talks to /api/rpc and /api/auth; these values never ship to client JavaScript.

# Existing Devnet RPC used by /api/rpc and server-side contract party reads.
SOLANA_RPC_URL=

# Neon Postgres connection string for Contract Messages.
DATABASE_URL=

# 32+ character secret used to HMAC wallet session tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Separate 32+ character secret for PREMIFLOW website account authentication.
# Keep this independent from SESSION_SECRET. Generate with: openssl rand -base64 48
ACCOUNT_AUTH_SECRET=

# Allowed browser origin for cookie-authenticated POST routes. Example: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Google OAuth for PREMIFLOW account sign-in.
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Local Google Authorized redirect URI:
# http://localhost:3000/api/account-auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Challenge lifetime in seconds. Default 300.
# AUTH_CHALLENGE_TTL_SECONDS=300

# Optional. Session lifetime in seconds. Default 604800 (7 days).
# SESSION_TTL_SECONDS=604800

# --- PREMIFLOW Copilot (server-only). Never prefix with NEXT_PUBLIC_. ---

# Set true to enable model-backed PREMIFLOW Assistant responses.
# General product guidance does not require a connected wallet.
# Contract-specific authenticated modes keep their existing wallet/session checks.
# When false or unset, deterministic fallback guidance remains available.
# COPILOT_ENABLED=false

# Supported provider: openai or groq.
# COPILOT_PROVIDER=groq

# Model id for the configured provider.
# OpenAI example: gpt-4o-mini
# Groq example: openai/gpt-oss-20b
# COPILOT_MODEL=openai/gpt-oss-20b

# Provider API keys are server-only. Never use NEXT_PUBLIC_ for these.
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Optional model output cap.
# COPILOT_MAX_OUTPUT_TOKENS=1200
